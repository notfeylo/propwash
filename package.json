{
  "name": "propwash",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source, browser-based FPV drone simulator built for realism.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "assets": "node tools/build-assets.mjs",
    "verify-assets": "node tools/verify-assets.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:visual": "node tools/verify-visual.mjs",
    "verify:audio": "node tools/verify-audio.mjs",
    "verify:budgets": "node tools/verify-budgets.mjs",
    "record:gif": "node tools/record-gif.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-deterministic-compat": "0.21.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/cli": "^4.5.0",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "eslint": "^10.11.0",
    "gl-matrix": "^3.4.4",
    "globals": "^17.12.0",
    "meshoptimizer": "^1.2.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
